{
  "name": "hogar-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Hogar — app familiar integral (PWA) con sincronización a Google Sheets/Drive vía Apps Script",
  "scripts": {
    "dev": "vite",
    "build": "npm run gas:schema && tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "gas:schema": "node scripts/gen-gas-schema.mjs",
    "gas:login": "clasp login",
    "gas:create": "node scripts/gas.mjs create",
    "gas:push": "node scripts/gas.mjs push",
    "gas:deploy": "node scripts/gas.mjs deploy"
  },
  "dependencies": {
    "@fontsource/inter": "5.1.0",
    "dexie": "4.0.10",
    "dexie-react-hooks": "1.1.7",
    "lucide-react": "0.460.0",
    "pdfjs-dist": "4.8.69",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "tesseract.js": "5.1.1"
  },
  "devDependencies": {
    "@google/clasp": "^2.4.2",
    "@playwright/test": "1.49.1",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.10.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "fake-indexeddb": "6.0.0",
    "jsdom": "25.0.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-pwa": "0.21.1",
    "vitest": "2.1.8",
    "workbox-core": "7.3.0",
    "workbox-precaching": "7.3.0",
    "workbox-routing": "7.3.0",
    "workbox-strategies": "7.3.0"
  }
}
